# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=file-cabinet-uploads
S3_KEY_PREFIX=uploads/

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=500
PRESIGNED_URL_EXPIRY=3600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime,video/webm,video/avi 