# Docker Environment Configuration
# Copy this file to .env and update with your configuration

# AWS Configuration (Required)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Port Configuration (Optional - defaults shown)
BACKEND_PORT=3001            # Backend port (both internal and host)
FRONTEND_PORT=3000           # Frontend host port

# Example: To run on different ports
# BACKEND_PORT=8080
# FRONTEND_PORT=9000
#
# This would make:
# - Backend available at: http://localhost:8080
# - Frontend available at: http://localhost:9000

# AWS credentials are discovered automatically from:
# - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN
# - AWS credentials file: ~/.aws/credentials
# - IAM roles (if running on AWS infrastructure)